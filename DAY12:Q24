//Q24.Write a program to calculate electricity bill based on units consumed with these rates: 
//First 100 units at ₹5/unit 
//Next 100 units at ₹7/unit 
//Next 100 units at ₹10/unit

#include<stdio.h>

int main(){

int amt1, units, amt2, amt3;

printf("Number of Units consumed");
scanf("%d", &units);

if(units<=100)
{
 amt1=units*5;
printf("Electricity Bill=%d", amt1);
}
if(units>100 && units<=200)
{
amt2=units*7-200;
printf("Electricity Bill=%d", amt2);
}
if(units>200 && units<=300)
{
amt3=units*10-800;
printf("Electricity Bill=%d", amt3);
}

}
