# Program-to-swap-two-numbers-using-a-third-variable.
//Q6: Write a program to swap two numbers using a third variable.

#include <stdio.h>

int main(){
int a, b, c;

printf("Enter the value of a and b");
scanf("%d%d", &a, &b);

c=a*b;
a=c/a;
b=c/a;

printf("After swapping a=%d and b=%d", a, b);

return 0;

}
